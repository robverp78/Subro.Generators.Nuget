<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>

    <PackageId>Viaduct</PackageId>
    <Title>Viaduct</Title>
    <Description>
      Meta-package that includes both Viaduct.Server and Viaduct.Client.
      Reference this package when your project needs both server-side endpoint mapping
      and client-side HTTP proxy generation (e.g. integration tests, monoliths).
      For most projects, reference Viaduct.Server or Viaduct.Client directly instead.
    </Description>

    <!-- No source files, no build output — this is purely a dependency carrier -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <!--
    Both packages depend on Viaduct.Generator. NuGet resolves it to a single version,
    so the generator runs exactly once even when both are referenced.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Viaduct\Viaduct.Server.csproj" />
    <ProjectReference Include="..\Viaduct.Client\Viaduct.Client.csproj" />
  </ItemGroup>

</Project>
