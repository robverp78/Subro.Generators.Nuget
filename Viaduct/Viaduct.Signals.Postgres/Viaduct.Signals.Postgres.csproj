<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <LangVersion>14</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <PackageId>Viaduct.Signals.Postgres</PackageId>
    <Title>Viaduct.Signals.Postgres</Title>
    <Description>
      PostgreSQL store and bus for Viaduct's signals: signals kept in a table for clients catching up, and
      LISTEN/NOTIFY to tell every server of an application. Server-side only.
    </Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Viaduct\Viaduct.Server.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" Version="8.0.5" />
  </ItemGroup>

</Project>
