<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <LangVersion>14</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>

    <PackageId>Viaduct.Server</PackageId>
    <Title>Viaduct.Server</Title>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>
      Server-side runtime for Viaduct. Automatically maps DI service interfaces to
      ASP.NET Core Minimal API endpoints via the Viaduct source generator.
      Install this package in your ASP.NET Core server project.
    </Description>
  </PropertyGroup>

  <!--
    The generator is referenced as a ProjectReference here so that:
      - Local development and debugging work exactly as before (ProjectReference semantics).
      - When this project is packed, MSBuild translates it to a PackageReference in the
        .nuspec automatically, using the same Version from Directory.Build.props.
        Consumers therefore receive Viaduct.Generator as a transitive dependency without
        any manual step.

    OutputItemType="Analyzer"        → the generator runs on projects that reference this package.
    ReferenceOutputAssembly="false"  → the generator DLL is not added to compilation references.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Viaduct.Generator\Viaduct.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Viaduct.Core\Viaduct.Core.csproj" />
    <ProjectReference Include="..\..\Subro.Json\Subro.Json\Subro.Json.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!--
    Ship a .props file inside the package so that any project that installs Viaduct.Server
    automatically gets the InterceptorsNamespaces setting — no manual step required.
    The file name must match the PackageId for NuGet to import it automatically.
  -->
  <ItemGroup>
    <None Include="build\Viaduct.Server.props" Pack="true" PackagePath="build\" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
