<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <LangVersion>14</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>

    <PackageId>Viaduct.Server</PackageId>
    <Title>Viaduct.Server</Title>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>
      Server-side runtime for Viaduct. Automatically maps DI service interfaces to
      ASP.NET Core Minimal API endpoints via the Viaduct source generator.
      Install this package in your ASP.NET Core server project.
    </Description>
  </PropertyGroup>

  <!--
    The generator runs on this project through the ProjectReference below, and reaches consumers of
    the package inside Viaduct.Core — see the comment there for why it travels with that package
    rather than this one.

    PrivateAssets="none" on Viaduct.Core is what lets it: NuGet keeps a dependency's analyzers and
    build assets private by default, which would leave the generator sitting unused in the package
    graph. Until 0.1.2 this reference was the way consumers were meant to get the generator, and
    they never did — pack drops a ProjectReference that carries no compile-time output.

    OutputItemType="Analyzer"        → the generator runs while building this project.
    ReferenceOutputAssembly="false"  → the generator DLL is not added to compilation references.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Viaduct.Generator\Viaduct.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
    <ProjectReference Include="..\Viaduct.Core\Viaduct.Core.csproj" PrivateAssets="none" />
    <ProjectReference Include="..\..\Subro.Json\Subro.Json\Subro.Json.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!--
    Ship a .props file inside the package so that any project that installs Viaduct.Server
    automatically gets the InterceptorsNamespaces setting — no manual step required.
    The file name must match the PackageId for NuGet to import it automatically.
  -->
  <ItemGroup>
    <None Include="build\Viaduct.Server.props" Pack="true" PackagePath="build\" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
