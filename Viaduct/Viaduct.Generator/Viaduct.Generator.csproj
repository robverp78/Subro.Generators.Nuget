<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsRoslynComponent>true</IsRoslynComponent>

    <PackageId>Viaduct.Generator</PackageId>
    <Title>Viaduct.Generator (internal)</Title>
    <Description>
      Internal source generator used by Viaduct.Server and Viaduct.Client.
      You do not need to install this package directly — it is a transitive dependency
      of those packages.
    </Description>

    <!--
      Keep the generator DLL out of lib/ so it is never treated as a runtime reference.
      The DLL is packed explicitly into analyzers/dotnet/cs/ below.
    -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <!--
      Do not list Roslyn or other build-time packages as runtime dependencies
      in the published .nuspec.
    -->
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <!-- Signals to NuGet that this is a build-time-only package -->
    <DevelopmentDependency>true</DevelopmentDependency>
  </PropertyGroup>

	<PropertyGroup>
		<TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);_AddAnalyzersToOutput</TargetsForTfmSpecificContentInPackage>
	</PropertyGroup>

	<Target Name="_AddAnalyzersToOutput">
		<ItemGroup>
			<TfmSpecificPackageFile Include="$(OutputPath)$(AssemblyName).dll" PackagePath="analyzers/dotnet/cs" />
		</ItemGroup>
	</Target>

  <!--
    All PackageReferences are build-time only; mark them private so they do not
    appear as dependencies in the nuspec (which would be wrong for a generator package).
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.Common" Version="5.0.0">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Subro.Generators.TransformResult" Version="1.5.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="System.Text.Json" Version="9.0.0">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>


  <ItemGroup>
    <Using Include="System.Linq" />
    <Using Include="System.Collections.Generic" />
    <Using Include="System.Threading.Tasks" />
    <Using Include="System.Threading" />
    <Using Include="System.Text" />
  </ItemGroup>

  <Import Project="..\Viaduct.Shared\Viaduct.Shared.projitems" Label="Shared" />
  <Import Project="..\Viaduct.Client.Shared\Viaduct.Client.Shared.projitems" Label="Shared" />
  <Import Project="..\..\Subro.Generators.Core\Subro.Generators.Core.projitems" Label="Shared" />

</Project>
