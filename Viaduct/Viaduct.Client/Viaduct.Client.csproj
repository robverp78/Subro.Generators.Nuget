<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <LangVersion>14</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>

    <PackageId>Viaduct.Client</PackageId>
    <Title>Viaduct.Client</Title>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>
      Client-side runtime for Viaduct. Automatically generates typed HttpClient proxies
      from service interfaces via the Viaduct source generator.
      Install this package in your client or consumer project.
    </Description>
  </PropertyGroup>

  <!-- See Viaduct.Server.csproj for an explanation of this pattern. -->
  <ItemGroup>
    <ProjectReference Include="..\Viaduct.Generator\Viaduct.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Viaduct.Core\Viaduct.Core.csproj" />
    <ProjectReference Include="..\..\Subro.Json\Subro.Json\Subro.Json.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="build\Viaduct.Client.props" Pack="true" PackagePath="build\" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <Import Project="..\Viaduct.Client.Shared\Viaduct.Client.Shared.projitems" Label="Shared" />

</Project>
