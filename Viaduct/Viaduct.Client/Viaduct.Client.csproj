<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	  <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
	  <LangVersion>14</LangVersion>
	  <ImplicitUsings>enable</ImplicitUsings>
	  <Nullable>enable</Nullable>
	  <GenerateDocumentationFile>true</GenerateDocumentationFile>
	  <IsAotCompatible>true</IsAotCompatible>
	  <IsTrimmable>true</IsTrimmable>

	  <!-- NuGet package metadata -->
	  <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
	  <PackageId>Viaduct.Client</PackageId>
	  <Version>1.0.0</Version>
	  <Authors>Robert Verpalen</Authors>
	  <Description>
		  Client-side implementation for Viaduct.
		  Automatically brings in Viaduct.Core for shared attributes and contracts.
	  </Description>
	  <PackageTags>viaduct;client;aot;httpclient</PackageTags>
	  <PackageReadmeFile>README.md</PackageReadmeFile>
	  <PackageLicenseExpression>MIT</PackageLicenseExpression>
	  <Company>Subro Software</Company>
  </PropertyGroup>

	
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Subro.Json\Subro.Json\Subro.Json.csproj" />
    <ProjectReference Include="..\Viaduct.Core\Viaduct.Core.csproj" />
  </ItemGroup>

  <Import Project="..\Viaduct.Client.Shared\Viaduct.Client.Shared.projitems" Label="Shared" />	

</Project>
