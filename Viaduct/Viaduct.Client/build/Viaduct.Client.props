<Project>
  <PropertyGroup>
    <!-- Opt the consuming project into the Viaduct interceptor namespace.
         This is required for the [InterceptsLocation] attributes emitted by the
         Viaduct source generator to be recognised by the C# compiler. -->
    <InterceptorsNamespaces>$(InterceptorsNamespaces);Viaduct.Generated</InterceptorsNamespaces>
  </PropertyGroup>

  <!--
    Hand the XML documentation of referenced assemblies to the Viaduct generator, so an interface that lives in
    a contracts project of its own still documents its endpoints.

    The compiler writes these files but never gives a generator the documentation of a reference, and an
    analyzer may not read files itself (RS1035). AdditionalFiles is the supported route, but adding the .xml
    files directly is not: every generator sees AdditionalFiles, and ASP.NET Core's own XML comment generator
    takes any .xml among them as documentation to process — handed the framework's, it generates a file so
    large the build fails on the metadata string limit.

    So each one is copied next to the build output under an extension only this generator looks for.

    Only referenced projects are handed over, which is where a shared interface normally lives. A package is not:
    taking every reference's documentation handed a project with many packages hundreds of files (Vesta.Api: 315,
    75 MB, framework assemblies among them). An interface that comes from a package is named by assembly in
    ViaductDocumentationAssemblies, separated by semicolons:
      <ViaductDocumentationAssemblies>My.Contracts</ViaductDocumentationAssemblies>
    The generator then opens only the file of the assembly an undocumented method was declared in.
  -->
  <Target Name="ViaductAddReferenceDocumentation"
          BeforeTargets="CoreCompile"
          DependsOnTargets="ResolveAssemblyReferences"
          Inputs="@(_ViaductReferenceDocumentationSource)"
          Outputs="@(_ViaductReferenceDocumentationSource->'$(IntermediateOutputPath)viaduct/%(Filename).viaductdoc')">
    <Copy SourceFiles="@(_ViaductReferenceDocumentationSource)"
          DestinationFiles="@(_ViaductReferenceDocumentationSource->'$(IntermediateOutputPath)viaduct/%(Filename).viaductdoc')"
          SkipUnchangedFiles="true" />
  </Target>

  <!--
    Collected outside the target as well, so the AdditionalFiles are known during evaluation of the compile
    itself rather than only while the copy runs.
  -->
  <Target Name="ViaductCollectReferenceDocumentation"
          BeforeTargets="ViaductAddReferenceDocumentation"
          DependsOnTargets="ResolveAssemblyReferences">
    <PropertyGroup>
      <_ViaductDocumentationAssemblies>;$(ViaductDocumentationAssemblies);</_ViaductDocumentationAssemblies>
    </PropertyGroup>
    <ItemGroup>
      <_ViaductCandidateDocumentation Include="@(ReferencePath->'%(RootDir)%(Directory)%(Filename).xml')"
                                      Condition="'%(ReferencePath.ReferenceSourceTarget)' == 'ProjectReference' or $(_ViaductDocumentationAssemblies.Contains(';%(ReferencePath.Filename);'))" />
      <_ViaductReferenceDocumentationSource Include="@(_ViaductCandidateDocumentation)" Condition="Exists('%(Identity)')" />
      <AdditionalFiles Include="@(_ViaductReferenceDocumentationSource->'$(IntermediateOutputPath)viaduct/%(Filename).viaductdoc')" />
      <FileWrites Include="@(_ViaductReferenceDocumentationSource->'$(IntermediateOutputPath)viaduct/%(Filename).viaductdoc')" />

      <!-- Copies of documentation no longer handed over, such as the packages' from before only projects were. -->
      <_ViaductStaleDocumentation Include="$(IntermediateOutputPath)viaduct/*.viaductdoc"
                                  Exclude="@(_ViaductReferenceDocumentationSource->'$(IntermediateOutputPath)viaduct/%(Filename).viaductdoc')" />
    </ItemGroup>
    <Delete Files="@(_ViaductStaleDocumentation)" />
  </Target>

</Project>
